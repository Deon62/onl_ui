# Copy to .env.local (git-ignored) and fill in. Both Supabase values are public by design:
# the publishable/anon key only allows sign-in; all data access goes through the Oryne API.

# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase -> Project Settings -> API Keys -> Publishable key (or legacy "anon public" key). Never the secret/service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Oryne API (defaults to https://apiv1.oryne.org)
# VITE_API_URL=http://localhost:8000
